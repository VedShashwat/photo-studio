# Core application
APP_ENV=local
APP_VERSION=0.1.0
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database and local storage
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/studio
STORAGE_ROOT=./storage
PUBLIC_STORAGE_BASE_URL=
MAX_UPLOAD_MB=15

# Worker runtime and model configuration
DEVICE=cuda
TORCH_DTYPE=float16
SDXL_OFFLOAD_MODE=auto
MODEL_CACHE_DIR=./model_cache
BACKGROUND_REMOVAL_MODEL=ZhengPeng7/BiRefNet
SDXL_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
SDXL_CANNY_CONTROLNET_MODEL=diffusers/controlnet-canny-sdxl-1.0
MAX_CONCURRENT_GPU_JOBS=1
DEFAULT_CANVAS_SIZE=1024

# Operational controls
JOB_POLL_INTERVAL_SECONDS=2.0
JOB_TIMEOUT_SECONDS=1800
LOG_LEVEL=INFO
